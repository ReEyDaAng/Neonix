generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ChannelKind {
  TEXT
  VOICE
  VIDEO
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  displayName String
  username    String
  createdAt   DateTime @default(now())

  messages    Message[]
  annotations Annotation[]
  ownedRooms  Room[]   @relation("RoomOwner")

  memberships          RoomMembership[]
  friendshipsRequested Friendship[]     @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]     @relation("FriendshipAddressee")
  invitationsSent      RoomInvitation[] @relation("InvitationInviter")
  invitationsReceived  RoomInvitation[] @relation("InvitationInvitee")
}

model Room {
  id        String   @id @default(uuid())
  name      String
  meta      String
  badge     String
  ownerId   String?
  createdAt DateTime @default(now())

  owner       User?            @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  channels    Channel[]
  messages    Message[]
  memberships RoomMembership[]
  invitations RoomInvitation[]
}

model Channel {
  id        String      @id @default(uuid())
  roomId    String
  name      String
  kind      ChannelKind @default(TEXT)
  createdAt DateTime    @default(now())

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  messages     Message[]
  callSessions CallSession[]
  annotations  Annotation[]

  @@unique([roomId, name])
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  channelId String
  userId    String?
  who       String
  text      String
  time      String
  me        Boolean  @default(false)
  createdAt DateTime @default(now())

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, channelId])
  @@index([roomId, channelId, createdAt])
}

model CallSession {
  id              String    @id @default(uuid())
  channelId       String
  livekitRoom     String
  presenterUserId String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model Annotation {
  id        String   @id @default(uuid())
  channelId String
  userId    String?
  payload   Json
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}

/// Membership in a room (who can see the room and its channels).
/// The room owner is also represented here so listings stay simple.
model RoomMembership {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

/// One-row-per-pair friendship. A friendship goes through PENDING -> ACCEPTED.
/// `requesterId` is the user who initiated the request.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// Pending invitation from a member of a room to another user. Accepting
/// creates a `RoomMembership` row.
model RoomInvitation {
  id          String           @id @default(uuid())
  roomId      String
  inviterId   String
  inviteeId   String
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter User @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([roomId, inviteeId])
  @@index([inviteeId, status])
}
