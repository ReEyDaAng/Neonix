generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ChannelKind {
  TEXT
  VOICE
  VIDEO
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  displayName String
  username    String
  createdAt   DateTime @default(now())

  messages    Message[]
  annotations Annotation[]
}

model Room {
  id        String   @id @default(uuid())
  name      String
  meta      String
  badge     String
  createdAt DateTime @default(now())

  channels Channel[]
  messages Message[]
}

model Channel {
  id        String      @id @default(uuid())
  roomId    String
  name      String
  kind      ChannelKind @default(TEXT)
  createdAt DateTime    @default(now())

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  messages     Message[]
  callSessions CallSession[]
  annotations  Annotation[]

  @@unique([roomId, name])
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  channelId String
  userId    String?
  who       String
  text      String
  time      String
  me        Boolean  @default(false)
  createdAt DateTime @default(now())

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, channelId])
  @@index([roomId, channelId, createdAt])
}

model CallSession {
  id              String    @id @default(uuid())
  channelId       String
  livekitRoom     String
  presenterUserId String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model Annotation {
  id        String   @id @default(uuid())
  channelId String
  userId    String?
  payload   Json
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}
