# Backend environment — production
# Copy to ~/apps/neonix/.env.backend on the VPS and fill in real values.

# Core
PORT=4000
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=https://neonix.app

# JWT — generate a long random secret (e.g. `openssl rand -hex 64`).
JWT_SECRET=replace_me_with_a_long_random_value

# Database (PostgreSQL inside docker-compose)
POSTGRES_DB=neonix
POSTGRES_USER=neonix
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://neonix:replace_me@postgres:5432/neonix?schema=public
DIRECT_URL=postgresql://neonix:replace_me@postgres:5432/neonix?schema=public

# Redis (Socket.IO adapter + LiveKit room state)
REDIS_URL=redis://redis:6379/0

# LiveKit — generate via `scripts/gen-livekit-key.sh`
LIVEKIT_API_KEY=replace_me_api_key
LIVEKIT_API_SECRET=replace_me_api_secret
LIVEKIT_URL=wss://livekit.neonix.app
# Optional override for backend->server SDK calls (defaults to wss URL converted to https)
# LIVEKIT_HTTP_URL=https://livekit.neonix.app

# coturn — used by LiveKit clients as ICE relay
TURN_HOST=turn.neonix.app
TURN_USERNAME=neonix
TURN_PASSWORD=replace_me_turn_secret
TURN_TLS=true
